# LLM APIs
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Social Platform APIs
TWITTER_BEARER_TOKEN=...
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
YOUTUBE_API_KEY=...

# Infrastructure
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smda
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Research Crawler
SEMANTIC_SCHOLAR_API_KEY=...
ARXIV_SEARCH_ENABLED=true

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
API_RATE_LIMIT_PER_MIN=100
VERDICT_CACHE_TTL_HOURS=24
LLM_BATCH_SIZE=20
LLM_DEFAULT_TEMPERATURE=0
